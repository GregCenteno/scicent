# Postgres connection string (Neon, Supabase, Railway, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/scicent?schema=public"

# openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Shared secret the refresh cron must send as the "x-cron-secret" header.
# openssl rand -hex 24
CRON_SECRET="replace-with-a-random-secret"
