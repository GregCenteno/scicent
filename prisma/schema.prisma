generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  ENFERMERIA
  MEDICINA
  FARMACIA
  FARMACOLOGIA
  NUTRICION
  REHABILITACION
  ODONTOLOGIA
  LABORATORIO_CLINICO
}

model User {
  id           String        @id @default(cuid())
  name         String
  username     String        @unique
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  interactions Interaction[]
  reposts      Repost[]

  // Social graph: a Follow row means `followerId` follows `followingId`.
  following Follow[] @relation("Follower")
  followers Follow[] @relation("Followee")
}

model Article {
  id            String        @id @default(cuid())
  // "<europepmc source>:<europepmc id>", e.g. "MED:39876543" — used to dedupe on refresh.
  sourceId      String        @unique
  category      Category
  title         String
  hook          String        @db.Text
  abstract      String?       @db.Text
  journal       String?
  authors       String?
  // Código de idioma tal como lo reporta Europe PMC (p. ej. "spa", "eng").
  // Puede venir vacío si la fuente no lo informa.
  language      String?
  // Derivado de `language` al momento de la ingesta — permite ordenar
  // "primero en español" sin comparar strings en cada consulta.
  isSpanish     Boolean       @default(false)
  // Tal como lo reporta Europe PMC (campo isOpenAccess: "Y"/"N").
  isOpenAccess  Boolean       @default(false)
  publishedAt   DateTime?
  url           String
  createdAt     DateTime      @default(now())
  interactions  Interaction[]
  reposts       Repost[]

  @@index([category, publishedAt])
  @@index([isSpanish, publishedAt])
}

model Interaction {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  liked     Boolean  @default(false)
  saved     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

// A user "reposting" an article onto their own profile, optionally with a
// short comment — this is what a follower's "siguiendo" feed reads from.
model Repost {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([createdAt])
}

// The social graph. `followerId` follows `followingId`. Self-follow is
// rejected in the API route, not here (Prisma can't express that check).
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followee", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}
